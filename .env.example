# Default mode is offline and deterministic. No API key or network call is needed.
TRACEWORK_ENGINE=offline
TRACEWORK_DATA_DIR=.data
# Optional PDF: run `uv run python scripts/setup_pdf.py` from the repo root.
# TRACEWORK_MINERU_PYTHON=/absolute/path/to/isolated/mineru/python
# Optional local model. Configure in your shell; .env is not loaded automatically.
# TRACEWORK_ENGINE=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-installed-model
